# Application
APP_NAME=Class Checker API
APP_VERSION=0.1.0
ENVIRONMENT=development

# CORS: comma-separated frontend origins allowed to send credentialed requests.
ALLOWED_ORIGINS=http://localhost:3000

# Session signing secret (HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production: the app refuses to start if this is unset or the
# dev-only default in code. Local dev may leave it unset.
SESSION_TTL_MINUTES=1440

# Local PostgreSQL (Docker Compose)
# Used only when SUPABASE_DB_URL is empty.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=class_checker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=class_checker

# Supabase (production)
#
# SUPABASE_DB_URL takes precedence over the local PostgreSQL settings above.
# Copy one of the connection strings from the Supabase dashboard (Connect) and
# paste it here:
#
#   Direct connection (persistent backend, IPv6 or IPv4 add-on):
#     postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
#   Session pooler (persistent backend on an IPv4-only network, port 5432):
#     postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres
#
# Both support SQLAlchemy and prepared statements. The transaction pooler
# (port 6543) is intended for serverless/edge runtimes and is not used here.
# The "postgresql://" or "postgres://" scheme is normalized to the SQLAlchemy
# "postgresql+psycopg://" driver automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
